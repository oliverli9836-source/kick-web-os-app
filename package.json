{
  "name": "kick-web-os-app",
  "version": "0.9.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "test": "node test.cjs && node --expose-gc test-player-resources.cjs && node test-service-legacy.js && node test-service-resources.js && node test-build-deps.cjs",
    "start": "python3 -m http.server 8080 --bind 127.0.0.1 --directory app",
    "package": "ares-package app service --outdir dist",
    "test:browser": "node test-browser.cjs"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6",
    "braces": "file:./vendor/security/braces-3.0.4-security.2.tgz",
    "playwright": "1.64.1",
    "sprintf-js": "file:./vendor/security/sprintf-js-1.1.4-security.1.tgz"
  },
  "overrides": {
    "braces": "$braces",
    "sprintf-js": "$sprintf-js",
    "@webos-tools/cli": {
      "qs": "6.16.0",
      "brace-expansion@^1.1.7": "1.1.21",
      "brace-expansion@^5.0.8": "5.0.12",
      "proxy-addr": "2.0.8"
    }
  }
}
